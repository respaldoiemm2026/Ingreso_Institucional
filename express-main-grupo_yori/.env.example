# Copiar como .env y completar los valores
# PostgreSQL (Neon). En Neon conviene una rama "dev" distinta de la de producción.
DATABASE_URL="postgresql://usuario:clave@host.neon.tech/neondb?sslmode=verify-full"
# Mínimo 32 caracteres en producción: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="cambia-esto-por-un-valor-largo-y-aleatorio"
JWT_EXPIRES_IN=1h
PORT=3000
# Zona horaria con la que se calculan los días (Render corre en UTC)
TZ=America/Bogota
# Orígenes del frontend permitidos, separados por coma, sin "/" final. "*" sirve para los previews de Vercel.
CORS_ORIGIN="http://localhost:5500,http://127.0.0.1:5500"
# lax con el proxy de Vercel (recomendado); none solo si el frontend llama directo a onrender.com
COOKIE_SAMESITE=lax
# Proxies delante de la API: 1 = solo Render, 2 = Vercel + Render
TRUST_PROXY=1

# Usuario administrador inicial (npm run db:seed)
ADMIN_NOMBRE="Administrador"
ADMIN_EMAIL="admin@montessori.edu"
ADMIN_PASSWORD="cambia-esta-clave"
